{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["custom/launcher", "keyboard", "sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["custom/powermenu"],
    "modules-right": ["tray", "pulseaudio", "network", "cpu", "memory", "battery", "clock", "custom/exit"],
    "custom/launcher": {
        "format": "𖠿",
        "tooltip": false,
        "on-click": "pkill wofi || wofi --show drun",
        "on-click-middle": "pkill wofi || wofi --show run",
        "return-type": "json"
    },
    "sway/workspaces": {
        "format": "{name}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "urgent": "",
            "focused": "",
            "default": ""
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{mode}</span>"
    },
    "sway/window": {
        "format": "{}",
        "max-length": 50
    },
    "custom/powermenu": {
        "format": "",
        "tooltip": false,
        "on-click": "wofi --show dmenu --prompt 'Power Menu:' --conf ~/.config/wofi/powermenu.conf --cache-file /dev/null | sh ~/.config/waybar/scripts/powermenu.sh"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },
    "network": {
        "format": "{icon} {ipaddr}",
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": "",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "nm-connection-editor",
        "on-click-right": "nm-applet"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
        "interval": 5
    },
    "memory": {
        "format": "⎶ ({percentage}%)",
        "interval": 5
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{:%A, %B %d}</small></tt>\n<tt><small>{:%H:%M:%S}</small></tt>",
        "interval": 1
    },
    "custom/exit": {
        "format": "",
        "tooltip": false,
        "on-click": "swaylock -f -i ~/.config/swaylock/lock.png"
    },
    "keyboard": {
        "format": "<span foreground='#ddaa00'>{layout}</span>",
        "tooltip": true,
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    }
}
